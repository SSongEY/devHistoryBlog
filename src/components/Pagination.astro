---
interface Props {
  currentPage: number;
  lastPage: number;
  baseHref: string; // 1페이지 URL (예: /devHistoryBlog 또는 /devHistoryBlog/tags/xxx)
}
const { currentPage, lastPage, baseHref } = Astro.props;
// baseHref는 항상 trailing slash로 끝난다(예: /devHistoryBlog/ 또는 /devHistoryBlog/tags/xxx/)
const url = (n: number) => (n === 1 ? baseHref : `${baseHref}${n}/`);

// 윈도우형 페이지 번호: 1 … (현재±2) … lastPage
const w = 2;
const set = new Set<number>([1, lastPage, currentPage]);
for (let i = 1; i <= w; i++) {
  set.add(currentPage - i);
  set.add(currentPage + i);
}
const nums = [...set].filter((n) => n >= 1 && n <= lastPage).sort((a, b) => a - b);
const items: (number | '…')[] = [];
let prev = 0;
for (const n of nums) {
  if (prev && n - prev > 1) items.push('…');
  items.push(n);
  prev = n;
}
---
{lastPage > 1 && (
  <nav class="pager" aria-label="페이지 네비게이션">
    {currentPage > 1 ? (
      <a class="pager-btn" href={url(currentPage - 1)} rel="prev">← 이전</a>
    ) : (
      <span class="pager-btn disabled">← 이전</span>
    )}
    <span class="pager-nums">
      {items.map((it) =>
        it === '…' ? (
          <span class="pager-gap">…</span>
        ) : it === currentPage ? (
          <span class="pager-num active" aria-current="page">{it}</span>
        ) : (
          <a class="pager-num" href={url(it)}>{it}</a>
        ),
      )}
    </span>
    {currentPage < lastPage ? (
      <a class="pager-btn" href={url(currentPage + 1)} rel="next">다음 →</a>
    ) : (
      <span class="pager-btn disabled">다음 →</span>
    )}
  </nav>
)}
