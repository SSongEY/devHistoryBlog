---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { href, tagUrl } from '../../../consts';

export const getStaticPaths = (async ({ paginate }) => {
  const PAGE_SIZE = 20;
  const posts = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
  const byTag = new Map<string, CollectionEntry<'posts'>[]>();
  for (const p of posts) {
    for (const t of p.data.tags) {
      if (!byTag.has(t)) byTag.set(t, []);
      byTag.get(t)!.push(p);
    }
  }
  return [...byTag.entries()].flatMap(([tag, list]) =>
    paginate(list.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()), {
      params: { tag },
      props: { tag },
      pageSize: PAGE_SIZE,
    }),
  );
}) satisfies GetStaticPaths;

const { page, tag } = Astro.props as {
  page: import('astro').Page<CollectionEntry<'posts'>>;
  tag: string;
};
---
<BaseLayout title={`#${tag}`}>
  <section class="hero">
    <div class="eyebrow">Tag</div>
    <h1>#{tag}</h1>
    <p>{page.total}개의 글</p>
  </section>

  <ul class="post-list">
    {page.data.map((post) => <PostCard post={post} />)}
  </ul>

  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} baseHref={tagUrl(tag)} />

  <a class="back-link" href={href('/tags')}>← 전체 태그</a>
</BaseLayout>
